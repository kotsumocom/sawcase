{
  "name": "@kotsumo/sawcase",
  "version": "1.0.1",
  "exports": {
    ".": "./mod.ts",
    "./styles": "./styles.ts",
    "./generate": "./generate.ts",
    "./setup": "./setup.ts",
    "./components": "./src/components/mod.ts",
    "./js": "./src/js/mod.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "styles.ts",
      "generate.ts",
      "setup.ts",
      "dist/sawcase.css",
      "src/",
      ".agents/",
      "docs/",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "demo/"
    ]
  },
  "tasks": {
    "build": "deno run -A src/build.ts",
    "sawcase:theme": "deno run -A generate.ts",
    "dev": "deno run -A --watch=src/ src/build.ts --watch",
    "preview": "deno run -A demo/server.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@material/material-color-utilities": "npm:@material/material-color-utilities@^0.3.0",
    "@deno/gfm": "jsr:@deno/gfm@^0.12",
    "@std/path": "jsr:@std/path@1",
    "preact": "npm:preact@^10.29.1",
    "preact/hooks": "npm:preact@^10.29.1/hooks",
    "lucide-preact": "npm:lucide-preact@^0.507.0",
    "@zag-js/clipboard": "npm:@zag-js/clipboard@^1.42.0",
    "@zag-js/dialog": "npm:@zag-js/dialog@^1.42.0",
    "@zag-js/tabs": "npm:@zag-js/tabs@^1.42.0",
    "@zag-js/toast": "npm:@zag-js/toast@^1.42.0",
    "@zag-js/menu": "npm:@zag-js/menu@^1.42.0",
    "@zag-js/tooltip": "npm:@zag-js/tooltip@^1.42.0",
    "@zag-js/accordion": "npm:@zag-js/accordion@^1.42.0",
    "@zag-js/preact": "npm:@zag-js/preact@^1.42.0",
    "@zag-js/switch": "npm:@zag-js/switch@^1.42.0",
    "@zag-js/select": "npm:@zag-js/select@^1.42.0",
    "@zag-js/checkbox": "npm:@zag-js/checkbox@^1.42.0",
    "@zag-js/radio-group": "npm:@zag-js/radio-group@^1.42.0",
    "@zag-js/date-picker": "npm:@zag-js/date-picker@^1.42.0",
    "@zag-js/popover": "npm:@zag-js/popover@^1.42.0",
    "@zag-js/hover-card": "npm:@zag-js/hover-card@^1.42.0",
    "@zag-js/slider": "npm:@zag-js/slider@^1.42.0",
    "@zag-js/number-input": "npm:@zag-js/number-input@^1.42.0",
    "@zag-js/tags-input": "npm:@zag-js/tags-input@^1.42.0",
    "@zag-js/combobox": "npm:@zag-js/combobox@^1.42.0",
    "@zag-js/file-upload": "npm:@zag-js/file-upload@^1.42.0",
    "@zag-js/collapsible": "npm:@zag-js/collapsible@^1.42.0",
    "@zag-js/steps": "npm:@zag-js/steps@^1.42.0",
    "@zag-js/pagination": "npm:@zag-js/pagination@^1.42.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "exclude": ["dist/", "demo/"]
  },
  "fmt": {
    "exclude": ["dist/"]
  }
}
