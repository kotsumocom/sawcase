{
  "name": "@kotsumo/sawcase",
  "version": "1.2.0",
  "exports": {
    ".": "./mod.ts",
    "./styles": "./styles.ts",
    "./generate": "./generate.ts",
    "./setup": "./setup.ts",
    "./components": "./src/components/mod.ts",
    "./js": "./src/js/mod.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "styles.ts",
      "generate.ts",
      "setup.ts",
      "dist/sawcase.css",
      "src/",
      ".agents/",
      "docs/",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "demo/"
    ]
  },
  "tasks": {
    "build": "deno run -A src/build.ts",
    "sawcase:theme": "deno run -A generate.ts",
    "dev": "deno run -A --watch=src/ src/build.ts --watch",
    "preview": "deno run -A demo/server.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@material/material-color-utilities": "npm:@material/material-color-utilities@^0.3.0",
    "@deno/gfm": "jsr:@deno/gfm@^0.12",
    "@std/path": "jsr:@std/path@1",
    "preact": "npm:preact@^10.29.1",
    "preact/hooks": "npm:preact@^10.29.1/hooks",
    "lucide-preact": "npm:lucide-preact@^1.23.0",
    "@zag-js/clipboard": "npm:@zag-js/clipboard@^1.42.0",
    "@zag-js/dialog": "npm:@zag-js/dialog@^1.42.0",
    "@zag-js/tabs": "npm:@zag-js/tabs@^1.42.0",
    "@zag-js/toast": "npm:@zag-js/toast@^1.42.0",
    "@zag-js/menu": "npm:@zag-js/menu@^1.42.0",
    "@zag-js/tooltip": "npm:@zag-js/tooltip@^1.42.0",
    "@zag-js/accordion": "npm:@zag-js/accordion@^1.42.0",
    "@zag-js/preact": "npm:@zag-js/preact@^1.42.0",
    "@zag-js/switch": "npm:@zag-js/switch@^1.42.0",
    "@zag-js/select": "npm:@zag-js/select@^1.42.0",
    "@zag-js/checkbox": "npm:@zag-js/checkbox@^1.42.0",
    "@zag-js/radio-group": "npm:@zag-js/radio-group@^1.42.0",
    "@zag-js/date-picker": "npm:@zag-js/date-picker@^1.42.0",
    "@zag-js/popover": "npm:@zag-js/popover@^1.42.0",
    "@zag-js/hover-card": "npm:@zag-js/hover-card@^1.42.0",
    "@zag-js/slider": "npm:@zag-js/slider@^1.42.0",
    "@zag-js/number-input": "npm:@zag-js/number-input@^1.42.0",
    "@zag-js/tags-input": "npm:@zag-js/tags-input@^1.42.0",
    "@zag-js/combobox": "npm:@zag-js/combobox@^1.42.0",
    "@zag-js/file-upload": "npm:@zag-js/file-upload@^1.42.0",
    "@zag-js/collapsible": "npm:@zag-js/collapsible@^1.42.0",
    "@zag-js/steps": "npm:@zag-js/steps@^1.42.0",
    "@zag-js/pagination": "npm:@zag-js/pagination@^1.42.0",
    "@zag-js/angle-slider": "npm:@zag-js/angle-slider@^1.42.0",
    "@zag-js/avatar": "npm:@zag-js/avatar@^1.42.0",
    "@zag-js/carousel": "npm:@zag-js/carousel@^1.42.0",
    "@zag-js/color-picker": "npm:@zag-js/color-picker@^1.42.0",
    "@zag-js/editable": "npm:@zag-js/editable@^1.42.0",
    "@zag-js/floating-panel": "npm:@zag-js/floating-panel@^1.42.0",
    "@zag-js/navigation-menu": "npm:@zag-js/navigation-menu@^1.42.0",
    "@zag-js/pin-input": "npm:@zag-js/pin-input@^1.42.0",
    "@zag-js/presence": "npm:@zag-js/presence@^1.42.0",
    "@zag-js/progress": "npm:@zag-js/progress@^1.42.0",
    "@zag-js/qr-code": "npm:@zag-js/qr-code@^1.42.0",
    "@zag-js/rating-group": "npm:@zag-js/rating-group@^1.42.0",
    "@zag-js/signature-pad": "npm:@zag-js/signature-pad@^1.42.0",
    "@zag-js/splitter": "npm:@zag-js/splitter@^1.42.0",
    "@zag-js/timer": "npm:@zag-js/timer@^1.42.0",
    "@zag-js/toggle": "npm:@zag-js/toggle@^1.42.0",
    "@zag-js/toggle-group": "npm:@zag-js/toggle-group@^1.42.0",
    "@zag-js/tour": "npm:@zag-js/tour@^1.42.0",
    "@zag-js/tree-view": "npm:@zag-js/tree-view@^1.42.0",
    "@zag-js/image-cropper": "npm:@zag-js/image-cropper@^1.42.0",
    "@zag-js/listbox": "npm:@zag-js/listbox@^1.42.0",
    "@zag-js/marquee": "npm:@zag-js/marquee@^1.42.0",
    "@zag-js/password-input": "npm:@zag-js/password-input@^1.42.0",
    "@zag-js/scroll-area": "npm:@zag-js/scroll-area@^1.42.0",
    "@zag-js/cascade-select": "npm:@zag-js/cascade-select@^1.42.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "exclude": ["dist/", "demo/"]
  },
  "fmt": {
    "exclude": ["dist/"]
  }
}
